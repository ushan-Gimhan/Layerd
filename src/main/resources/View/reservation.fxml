<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane style="-fx-background-color: #F2F3F4;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.service.Project.Controller.reservationController">
    <children>
        <VBox AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <VBox spacing="15.0" style="-fx-padding: 15; -fx-background-color: #FFFFFF; -fx-border-radius: 8; -fx-border-color: #D5D8DC;" VBox.vgrow="ALWAYS">
                <children>
                    <!-- Reservation Management Header -->
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #34495E; -fx-padding: 5;" text="Reservation Management" />

                    <!-- Input Fields for Reservation Details -->
                    <VBox spacing="10.0">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <TextField fx:id="txtReservationId" promptText="Reservation ID" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4; -fx-background-radius: 4;" HBox.hgrow="ALWAYS" />
                            <ComboBox fx:id="comboCustomerId" maxWidth="Infinity" onMouseClicked="#selectCustId" promptText="Customer ID" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4; -fx-background-radius: 4;" HBox.hgrow="ALWAYS" />
                            <ComboBox fx:id="comboLotId" maxWidth="Infinity" promptText="Lot ID" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4; -fx-background-radius: 4;" HBox.hgrow="ALWAYS" />
                            <ComboBox fx:id="comboFloorId" maxWidth="Infinity" promptText="Floor ID" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4; -fx-background-radius: 4;" HBox.hgrow="ALWAYS" />
                            <ComboBox fx:id="comboSpaceId" maxWidth="Infinity" promptText="Space ID" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4; -fx-background-radius: 4;" HBox.hgrow="ALWAYS" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <DatePicker fx:id="datePickerReservationDate" maxWidth="Infinity" promptText="Reservation Date" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4; -fx-background-radius: 4;" HBox.hgrow="ALWAYS" />
                            <DatePicker fx:id="comboEndDate" maxWidth="Infinity" promptText="End Date" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4; -fx-background-radius: 4;" HBox.hgrow="ALWAYS" />
                            <TextField fx:id="txtCustomerName" promptText="Customer Name" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4; -fx-background-radius: 4;" HBox.hgrow="ALWAYS" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <ComboBox fx:id="comboStartTime" maxWidth="Infinity" promptText="Start Time" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4; -fx-background-radius: 4;" HBox.hgrow="ALWAYS" />
                            <ComboBox fx:id="comboEndTime" maxWidth="Infinity" promptText="End Time" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4; -fx-background-radius: 4;" HBox.hgrow="ALWAYS" />
                        </HBox>

                        <!-- Label to display calculated amount -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 10 0 0 0;">
                            <Label fx:id="lblAmount" prefHeight="26.0" prefWidth="70.0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2E86C1;" text="Amount: " />
                            <Label fx:id="txtAmount" prefHeight="26.0" prefWidth="100.0" style="-fx-font-size: 16px; -fx-text-fill: #2E86C1;" text="0.00" />
                        </HBox>
                    </VBox>

                    <!-- Buttons for Managing Reservations -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 10 0 0 0;">
                        <Button onAction="#addReservation" style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-padding: 8; -fx-border-radius: 4; -fx-background-radius: 4;" text="Add Reservation" />
                        <Button onAction="#updateReservation" style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-padding: 8; -fx-border-radius: 4; -fx-background-radius: 4;" text="Update Reservation" />
                        <Button onAction="#deleteReservation" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-padding: 8; -fx-border-radius: 4; -fx-background-radius: 4;" text="Delete Reservation" />
                        <Button onAction="#GenarateReport" style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-padding: 8; -fx-border-radius: 4; -fx-background-radius: 4;" text="Genarate Report" />
                        <Button onAction="#makePayment" style="-fx-background-color: #2980B9; -fx-text-fill: white; -fx-padding: 8; -fx-border-radius: 4; -fx-background-radius: 4;" text="Make Payment" />
                        <Button onAction="#clearFields" style="-fx-background-color: #5D6D7E; -fx-text-fill: white; -fx-padding: 8; -fx-border-radius: 4; -fx-background-radius: 4;" text="Clear" />
                    </HBox>

                    <!-- Table for displaying reservations -->
                    <TableView fx:id="reservationTable" onMouseClicked="#reservationClicked" style="-fx-background-color: #F8F9F9; -fx-border-color: #D5D8DC; -fx-border-radius: 4;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="reservationIdColumn" text="Reservation ID" />
                            <TableColumn fx:id="customerIdColumn" text="Customer ID" />
                            <TableColumn fx:id="lotIdColumn" text="Lot ID" />
                            <TableColumn fx:id="floorIdColumn" text="Floor ID" />
                            <TableColumn fx:id="spaceIdColumn" text="Space ID" />
                            <TableColumn fx:id="reservationDateColumn" text="Reservation Date" />
                            <TableColumn fx:id="endDateColumn" text="End Date" />
                            <TableColumn fx:id="startTimeColumn" text="Start Time" />
                            <TableColumn fx:id="endTimeColumn" text="End Time" />
                            <TableColumn fx:id="customerNameColumn" text="Customer Name" />
                            <TableColumn fx:id="custAmountColum" text="Amount" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </children>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
