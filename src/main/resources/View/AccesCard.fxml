<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane style="-fx-background-color: #F4F6F7;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.service.project.parkinglot.Controller.AccesCardController">
    <children>
        <VBox spacing="15.0" style="-fx-padding: 15; -fx-background-color: #FFFFFF; -fx-border-radius: 8; -fx-border-color: #D5D8DC;" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <children>
                <!-- Header -->
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #34495E;" text="Access Card Management" />

                <!-- Input Fields -->
                <HBox spacing="10.0">
                    <TextField fx:id="txtAccessCardId" promptText="Access Card ID" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4; -fx-background-radius: 4;" />
                    <TextField fx:id="txtIssuedDate" promptText="Issued Date (YYYY-MM-DD)" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4; -fx-background-radius: 4;" />
                    <TextField fx:id="txtExpiryDate" promptText="Expiry Date (YYYY-MM-DD)" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4; -fx-background-radius: 4;" />
               <ComboBox fx:id="cmbComboBox" onAction="#cmbComboBoxOnAction" prefWidth="150.0" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-background-radius: 4; -fx-border-radius: 4;" />
                </HBox>

                <!-- Buttons -->
                <HBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="btnAdd" onAction="#addAccessCard" style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-padding: 8; -fx-border-radius: 4; -fx-background-radius: 4;" text="Add" />
                    <Button fx:id="btnUpdate" onAction="#updateAccessCard" style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-padding: 8; -fx-border-radius: 4; -fx-background-radius: 4;" text="Update" />
                    <Button fx:id="btnDelete" onAction="#deleteAccessCard" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-padding: 8; -fx-border-radius: 4; -fx-background-radius: 4;" text="Delete" />
                    <Button fx:id="btnRefresh" onAction="#refreshTable" style="-fx-background-color: #2980B9; -fx-text-fill: white; -fx-padding: 8; -fx-border-radius: 4; -fx-background-radius: 4;" text="Refresh" />
                </HBox>

                <!-- TableView -->
                <TableView fx:id="accessCardTable" onMouseClicked="#ClickedOnTable" style="-fx-background-color: #F8F9F9; -fx-border-color: #D5D8DC; -fx-border-radius: 4;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="accessCardIdColumn" text="Access Card ID" />
                        <TableColumn fx:id="issuedDateColumn" text="Issued Date" />
                        <TableColumn fx:id="expiryDateColumn" text="Expiry Date" />
                        <TableColumn fx:id="customerIdColumn" text="Customer ID" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>
