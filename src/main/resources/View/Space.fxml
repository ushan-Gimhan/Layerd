<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane style="-fx-background-color: #EAEDED;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.service.Project.Controller.SpaceController">
    <children>
        <VBox AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <VBox spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-border-color: #D5DBDB; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                <children>
                    <!-- Parking Lot Section -->
                    <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Parking Lot" />
                        <TableView fx:id="parkingLotTable" onMouseClicked="#clickedLotTable" style="-fx-background-color: #F8F9F9; -fx-border-color: #B3B6B7; -fx-border-radius: 4;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="lotIdColumn" text="Lot ID" />
                                <TableColumn fx:id="locationColumn" text="Location" />
                                <TableColumn fx:id="lotStatusColumn" text="Status" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <TextField fx:id="txtLotId" promptText="Lot ID" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4;" HBox.hgrow="ALWAYS" />
                            <TextField fx:id="txtLocation" promptText="Location" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4;" HBox.hgrow="ALWAYS" />
                            <ComboBox fx:id="comboLotStatus" maxWidth="Infinity" promptText="Status" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4;" HBox.hgrow="ALWAYS">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Available" />
                                        <String fx:value="Occupied" />
                                        <String fx:value="Under Maintenance" />
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Button fx:id="btnAddLot" onAction="#addLot" style="-fx-background-color: #5DADE2; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;" text="Add" />
                            <Button fx:id="btnUpdateLot" onAction="#UpdateLot" style="-fx-background-color: #58D68D; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;" text="Update" />
                        </HBox>
                    </VBox>

                    <!-- Floor Section -->
                    <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Floor Management" />
                        <TableView fx:id="floorTable" onMouseClicked="#ClickedLotTable" style="-fx-background-color: #F8F9F9; -fx-border-color: #B3B6B7; -fx-border-radius: 4;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="floorIdColumn" text="Floor ID" />
                                <TableColumn fx:id="lotIdFloorColumn" text="Lot ID" />
                                <TableColumn fx:id="floorStatusColumn" text="Status" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <TextField fx:id="txtFloorId" promptText="Floor ID" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4;" HBox.hgrow="ALWAYS" />
                            <TextField fx:id="txtLotIdFloor" promptText="Lot ID" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4;" HBox.hgrow="ALWAYS" />
                            <ComboBox fx:id="comboFloorStatus" maxWidth="Infinity" promptText="Status" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4;" HBox.hgrow="ALWAYS">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Available" />
                                        <String fx:value="Occupied" />
                                        <String fx:value="Closed" />
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Button fx:id="btnAddFloor" onAction="#Addfloor" style="-fx-background-color: #5DADE2; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;" text="Add" />
                            <Button fx:id="btnUpdateFloor" onAction="#updateFloor" style="-fx-background-color: #58D68D; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;" text="Update" />
                        </HBox>
                    </VBox>

                    <!-- Parking Space Section -->
                    <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Parking Space Management" />
                        <TableView fx:id="parkingSpaceTable" onMouseClicked="#spaceTable" style="-fx-background-color: #F8F9F9; -fx-border-color: #B3B6B7; -fx-border-radius: 4;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="spaceIdColumn" text="Space ID" />
                                <TableColumn fx:id="floorIdSpaceColumn" text="Floor ID" />
                                <TableColumn fx:id="spaceStatusColumn" text="Status" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <TextField fx:id="txtSpaceId" promptText="Space ID" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4;" HBox.hgrow="ALWAYS" />
                            <TextField fx:id="txtFloorIdSpace" promptText="Floor ID" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4;" HBox.hgrow="ALWAYS" />
                            <ComboBox fx:id="comboSpaceStatus" maxWidth="Infinity" promptText="Status" style="-fx-background-color: #EBF5FB; -fx-border-color: #A9CCE3; -fx-border-radius: 4;" HBox.hgrow="ALWAYS">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Available" />
                                        <String fx:value="Occupied" />
                                        <String fx:value="Reserved" />
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Button fx:id="btnAddSpace" onAction="#AddSpace" style="-fx-background-color: #5DADE2; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;" text="Add" />
                            <Button fx:id="btnUpdateSpace" onAction="#UpdateSpace" style="-fx-background-color: #58D68D; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;" text="Update" />
                        </HBox>
                    </VBox>
                </children>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
